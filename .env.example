# ====================================================================
# Gruhapravesam Environment Configuration
# ====================================================================

# Supabase REST API (Optional: website automatically falls back to local persistent store if omitted)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# Security Warning:
# NEVER put SUPABASE_SERVICE_ROLE_KEY or database passwords in client .env files.
# The frontend only requires the public anonymous key (VITE_SUPABASE_ANON_KEY).

# Admin Passcode for Host RSVP Dashboard (Default fallback: Gruham2026)
VITE_ADMIN_PASSCODE=Gruham2026

# Canonical Site URL (Used for Social Sharing & QR code fallback)
VITE_SITE_URL=https://gruhapravesam.kandula.family
